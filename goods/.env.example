# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ── Printrove Product Sync ─────────────────────────────────────────────────
# REQUIRED: Your Printrove account credentials.
# Used by `npm run sync` to authenticate and fetch products.
# Never commit these values — .env is gitignored.
PRINTROVE_EMAIL="your@email.com"
PRINTROVE_PASSWORD="yourpassword"

# OPTIONAL: How often the sync daemon runs (npm run sync:watch).
# Default is 6 hours if not set.
PRINTROVE_SYNC_INTERVAL_HOURS="6"

# ── Razorpay Payments ────────────────────────────────────────────────────────
# REQUIRED for checkout to work at all. Get these from Razorpay Dashboard →
# Settings → API Keys. Use test mode keys (rzp_test_...) until you're ready to
# go live, then swap to live mode keys (rzp_live_...).
# The server returns key_id to the client per-order, so there is only ONE key
# pair to manage here — no separate VITE_-prefixed client key needed.
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_key_secret"

# REQUIRED for the webhook receiver at POST /api/checkout/webhook.
# Get this from Razorpay Dashboard → Settings → Webhooks → (your webhook) →
# secret. Register the webhook URL as <your-domain>/api/checkout/webhook
# with the payment.captured event selected.
# This is the durable, server-to-server order-confirmation path — it fires
# even if the customer's browser never returns after payment. The client-side
# confirmation (verify-payment) is the fast path for immediate UX.
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# ── Order confirmation + return-request email (optional) ─────────────────────
# Leave SMTP_PASS blank to skip sending — orders still get confirmed/fulfilled
# and returns still get recorded without this, they just won't email anyone.
# Brand sender identity: ArtsyCheezein@gmail.com via Gmail SMTP. To enable:
#   1. Turn on 2-Step Verification on that Gmail account (Security settings).
#   2. Google Account → Security → App Passwords → generate one for "Mail".
#   3. Put the 16-character app password below as SMTP_PASS (not the normal
#      Gmail login password — Gmail SMTP rejects that).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="ArtsyCheezein@gmail.com"
SMTP_PASS=""
FROM_EMAIL="ArtsyCheezein@gmail.com"

# Internal notifications (e.g. new return request) land here — there's no
# admin dashboard in this app, so this is the only way the business finds out
# about a return as it comes in. Defaults to SMTP_USER if left blank.
MERCHANT_EMAIL="ArtsyCheezein@gmail.com"
